{
  "name": "ENDOMEC INBOX - Capturar evento (CONFIGURAR)",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "921c45f3-03e5-41ea-913f-ee91475f925b",
      "name": "Recibir evento",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => { const e = item.json.body || item.json; if (!e.instance || !e.event || !e.data) throw new Error('Faltan instance/event/data del webhook original'); return { json: { instance: e.instance, event: e.event, data: e.data } }; });"
      },
      "id": "2604038c-c180-452d-aa2b-74d694d6fb0c",
      "name": "Seleccionar evento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.ENDOMEC_INBOX_URL + '/api/integrations/evolution' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "44b667fa-2c77-420c-8a65-54e9dafe80bb",
      "name": "Copiar al Inbox - seleccionar credencial WEBHOOK",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => ({ json: { captured: !item.json.error && !(item.json.rejected > 0), result: item.json.error ? 'capture_failed' : item.json, originalItemIndex: i } }));"
      },
      "id": "2345bf14-c8df-4032-a830-cddf9f5307a2",
      "name": "Resultado de captura",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    }
  ],
  "connections": {
    "Recibir evento": {
      "main": [
        [
          {
            "node": "Seleccionar evento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Seleccionar evento": {
      "main": [
        [
          {
            "node": "Copiar al Inbox - seleccionar credencial WEBHOOK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Copiar al Inbox - seleccionar credencial WEBHOOK": {
      "main": [
        [
          {
            "node": "Resultado de captura",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "tags": []
}
